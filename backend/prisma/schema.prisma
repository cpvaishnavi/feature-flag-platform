datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
}
model Project {
  id        Int      @id @default(autoincrement())
  name      String
  ownerId   Int?
  createdAt DateTime @default(now())

  flags     FeatureFlag[]
  environments Environment[]
}
model FeatureFlag {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdBy   Int

  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])
  
  rollout     Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  environmentId Int?
environment   Environment? @relation(fields: [environmentId], references: [id])
  
}

model FlagRule {
  id                Int  @id @default(autoincrement())
  flagId            Int
  rolloutPercentage Int
  conditions        Json?
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  flagId    Int
  action    String
  userId    Int
  timestamp DateTime @default(now())
}

model Environment {
  id        Int      @id @default(autoincrement())
  name      String

  projectId Int
  project   Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  flags FeatureFlag[]
}